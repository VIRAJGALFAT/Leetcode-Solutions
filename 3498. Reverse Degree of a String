#https://leetcode.com/problems/reverse-degree-of-a-string/description/

class Solution:
    def reverseDegree(self, s: str) -> int:
        alpha = ord('z')
        degree = 0
        for i in range(1,len(s)+1):
            index = (alpha - ord(s[i-1]))+1
            product = index*i
            degree += product
        return degree
