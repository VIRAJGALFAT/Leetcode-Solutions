# https://leetcode.com/problems/number-of-ways-to-reorder-array-to-get-same-bst/description/

class Solution:
    def numOfWays(self, nums: list[int]) -> int:
        
        MOD = 1000000007
        n = len(nums)
        
        pt = []
        for i in range(n+1):
            row = [1] * (i+1)
            for j in range(1,i):
                row[j] = (pt[i-1][j-1]+pt[i-1][j]) % MOD
            pt.append(row)

        def solve(arr: List[int]) -> int:
            m  = len(arr)
            if m < 3:
                return 1
            root = arr[0]

            left = [x for x in arr[1:] if x < root]
            right =[x for x in arr[1:] if x > root]

            left_ways = solve(left) % MOD
            right_ways= solve(right) % MOD

            return (left_ways * right_ways % MOD) * pt[m-1][len(left)] % MOD

        return (solve(nums)- 1 + MOD) % MOD
