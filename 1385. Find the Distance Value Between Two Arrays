# https://leetcode.com/problems/find-the-distance-value-between-two-arrays/description/?envType=daily-question&envId=2026-11-05

class Solution:
    def findTheDistanceValue(self, arr1: list[int], arr2: list[int], d: int) -> int:
        cnt = 0
        for i in arr1:
            for j in arr2:
                if abs(i - j) > d: 
                    continue
                else:
                    cnt += 1
                    break
        return len(arr1) - cnt

