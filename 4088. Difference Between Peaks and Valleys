# https://leetcode.com/problems/difference-between-peaks-and-valleys/description/

class Solution:
    def peakValleyDifference(self, nums: list[int]) -> int:
        peck = 0
        valley = 0
        for i in range(1,len(nums) -1):
            if nums[i] > nums[i-1] and nums[i] > nums[i+1]:
                peck += nums[i]
            if nums[i] < nums[i-1] and nums[i] < nums[i+1]:
                valley += nums[i]
        return (peck - valley)




