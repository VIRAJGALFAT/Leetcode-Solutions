# https://leetcode.com/problems/battleships-in-a-board/description/

class Solution:
    def countBattleships(self, board: list[list[str]]) -> int:
        def dfs(board, r, c):
            if r >= m or r < 0 or c >= n or c < 0:
                return
            if board[r][c] == ".":
                return
            board[r][c] = "."

            dfs(board, r, c - 1)
            dfs(board, r, c + 1)
            dfs(board, r - 1, c)
            dfs(board, r + 1, c)

        m = len(board)
        n = len(board[0])
        cnt = 0
        for i in range(m):
            for j in range(n):
                if board[i][j] != ".":
                    dfs(board, i, j)
                    cnt += 1

        return cnt

