# https://leetcode.com/problems/non-overlapping-intervals/description/

class Solution:
    def eraseOverlapIntervals(self, intervals: List[List[int]]) -> int:
        n = len(intervals)
        intervals.sort(key=lambda x:x[1])
        
        cnt = 1
        last_call_end = intervals[0][1]
        for i in range(n):
            if intervals[i][0] >= last_call_end:
                cnt += 1
                last_call_end = intervals[i][1]
        return abs(n-cnt)  
