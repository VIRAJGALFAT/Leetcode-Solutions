# https://leetcode.com/problems/surrounded-regions/description/

class Solution:
    def solve(self, board: list[list[str]]) -> None:
        """
        Do not return anything, modify board in-place instead.
        """
        def dfs(r,c):
            if(r >= m or r < 0 or c >= n or c < 0):
                return 
            if board[r][c] != "O":
                return
            board[r][c] = "S" #never play it safe -->

            dfs(r,c-1)
            dfs(r,c+1)
            dfs(r-1,c)
            dfs(r+1,c)

        m = len(board)
        n = len(board[0])
        
        # boundary ke elements kbhi nahi ho skte mark them "S" baadme change kr lenge.
        for i in range(m):
            dfs(i, 0)
            dfs(i, n-1)
        for j in range(n):
            dfs(0, j)
            dfs(m-1, j)

        for i in range(m):
            for j in range(n):
                if board[i][j] == "O":
                   board[i][j] = "X"
                if board[i][j] == "S":
                   board[i][j] = "O"
            
        
        
