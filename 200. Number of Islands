# https://leetcode.com/problems/number-of-islands/description/

class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        def dfs(grid , r, c):
            
            #boundry check
            if (r >= m or r < 0 or c >= n or c < 0):
              return 
            
            if grid[r][c] == "0":
                return 

            grid[r][c] = "0"

            dfs(grid, r, c-1)
            dfs(grid, r, c+1)
            dfs(grid, r-1, c)
            dfs(grid, r+1, c)
        

        m = len(grid)
        n = len(grid[0])
        cnt = 0


        for i in range(m):
            for j in range(n):
                if grid[i][j] != "0":
                    dfs(grid, i ,j)
                    cnt += 1
        return cnt



        
