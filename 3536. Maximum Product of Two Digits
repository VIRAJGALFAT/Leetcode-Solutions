# https://leetcode.com/problems/maximum-product-of-two-digits/description/

class Solution:
    def maxProduct(self, n: int) -> int:
        n = str(n)
        p = 1
        res = []
        if len(n) == 2:
            for i in n:
                p *= int(i)
            return p
        else:
            for i in n:
                res.append(int(i))
            res.sort()
            return res[-1]*res[-2]
