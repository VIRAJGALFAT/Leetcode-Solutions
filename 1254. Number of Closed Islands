# https://leetcode.com/problems/number-of-closed-islands/description/

class Solution:
    def closedIsland(self, grid: list[list[int]]) -> int:
        def dfs(grid, r, c):
            # boundry ke bahar case
            if (r >= m or r < 0 or c >= n or c < 0):
                return False
            #base case hai  
            if grid[r][c] == 1:
                return True
            grid[r][c] = 1 # visited marked
            
            left = dfs(grid, r, c-1)
            right = dfs(grid, r, c+1)
            up = dfs(grid, r-1, c)
            down = dfs(grid, r+1, c)
            
            return left and right and up and down
        
        m = len(grid)
        n = len(grid[0])
        cnt = 0

        for i in range(m):
            for j in range(n):
                if grid[i][j] == 0: # land hai 
                   if dfs(grid, i , j ) == True: # recursion call 
                     cnt += 1
        return cnt
