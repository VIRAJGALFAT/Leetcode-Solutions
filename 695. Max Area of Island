# https://leetcode.com/problems/max-area-of-island/description/

class Solution:
    def maxAreaOfIsland(self, grid: list[list[int]]) -> int:
        def dfs(r,c):
            if(r >= m or r < 0 or c >= n or c < 0):
                return False
            if grid[r][c] == 0:
                return 0
            grid[r][c] = 0
            area = 1
            area += dfs(r,c-1)
            area += dfs(r,c+1)
            area += dfs(r-1,c)
            area += dfs(r+1,c)

            return area

        m = len(grid)
        n = len(grid[0])
        cnt = 0
        for i in range(m):
            for j in range(n):
                if grid[i][j] == 1:
                    area = dfs(i,j)
                    cnt = max(cnt, area)
        return cnt
