# https://leetcode.com/problems/smallest-index-with-digit-sum-equal-to-index/description/class Solution:
    def smallestIndex(self, nums: List[int]) -> int:
        def check(v):
            summ = 0
            v = str(v)
            for i in v:
                summ += int(i)
            return summ
        
        for i,v in enumerate(nums):
               if i == check(v):
                return i
        return -1
