# https://leetcode.com/problems/pascals-triangle/description/

class Solution:
    def generate(self, numRows: int) -> list[list[int]]:
        PT = []
        n = numRows
        for i in range(n):
            row = [1]*(i+1)
            for j in range(1,i):
                row[j] = (PT[i-1][j-1] +PT[i-1][j])
            PT.append(row)
        return PT

